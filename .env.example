# Copy to .env and adjust. The Makefile includes .env if present.
#
# Superuser connection, used only by `make db-bootstrap` / `make db-drop`.
# For Postgres.app / Homebrew this is your macOS user.
PG_ADMIN_URL=postgres://your-mac-user@localhost:5432/postgres

# Per-service connections. Each role's search_path is pinned to its own schema
# by scripts/db/bootstrap.sql, so golang-migrate keeps a separate
# schema_migrations table inside each schema.
PORTFOLIO_DB_URL=postgres://portfolio_svc:portfolio@localhost:5432/graphfolio?sslmode=disable
USER_DB_URL=postgres://user_svc:user@localhost:5432/graphfolio?sslmode=disable

# Apply embedded migrations when a service starts (dev convenience).
MIGRATE_ON_START=false

# Integration tests (make test-integration) use a separate database.
TEST_PORTFOLIO_DB_URL=postgres://portfolio_svc:portfolio@localhost:5432/graphfolio_test?sslmode=disable
TEST_USER_DB_URL=postgres://user_svc:user@localhost:5432/graphfolio_test?sslmode=disable
