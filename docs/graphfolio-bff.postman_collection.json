    {
      "name": "4. Transaction Ledger",
      "description": "Paginated transaction ledger queries, multi-criteria filtering, and execution details.",
      "item": [
        {
          "name": "List Transactions (Default Pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"GraphQL response has no errors\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.errors).to.be.undefined;",
                  "    pm.expect(jsonData.data).to.be.an(\"object\");",
                  "});",
                  "",
                  "pm.test(\"Transaction connection parsed\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const txs = jsonData.data.transactions;",
                  "    pm.expect(txs.items).to.be.an(\"array\");",
                  "    pm.expect(txs.totalCount).to.be.a(\"number\");",
                  "    pm.expect(txs.page).to.eql(1);",
                  "    if (txs.items.length > 0) {",
                  "        pm.collectionVariables.set(\"lastTransactionId\", txs.items[0].id);",
                  "        console.log(\"Cached lastTransactionId:\", txs.items[0].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ListTransactions($type: TransactionType, $symbol: String, $page: Int, $pageSize: Int) {\n  transactions(type: $type, symbol: $symbol, page: $page, pageSize: $pageSize) {\n    items {\n      id\n      type\n      symbol\n      instrumentName\n      tradeDate\n      quantity\n      price {\n        amount\n        currencyCode\n      }\n      amount {\n        amount\n        currencyCode\n      }\n      fee {\n        amount\n        currencyCode\n      }\n      notes\n      createdAt\n    }\n    totalCount\n    page\n    pageSize\n  }\n}",
                "variables": "{\n  \"page\": 1,\n  \"pageSize\": 20\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query"
              ]
            },
            "description": "Retrieves a paginated list of transactions from the ledger. Automatically caches the first item's ID into {{lastTransactionId}} for deletion testing."
          },
          "response": []
        },
