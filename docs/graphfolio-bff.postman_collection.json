                  "});",
                  "",
                  "pm.test(\"Portfolio history contains valuation points and return metrics\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.portfolioHistory.points).to.be.an(\"array\");",
                  "    pm.expect(jsonData.data.portfolioHistory.startValue).to.exist;",
                  "    pm.expect(jsonData.data.portfolioHistory.endValue).to.exist;",
                  "    pm.expect(jsonData.data.portfolioHistory.returnAmount).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetPortfolioHistory($timeframe: HistoryTimeframe!) {\n  portfolioHistory(timeframe: $timeframe) {\n    startValue {\n      amount\n      currencyCode\n    }\n    endValue {\n      amount\n      currencyCode\n    }\n    returnAmount {\n      amount\n      currencyCode\n    }\n    returnPercent\n    points {\n      date\n      totalValue {\n        amount\n        currencyCode\n      }\n      marketValue {\n        amount\n        currencyCode\n      }\n      cashValue {\n        amount\n        currencyCode\n      }\n      twrIndex\n      dailyReturn\n    }\n  }\n}",
                "variables": "{\n  \"timeframe\": \"{{timeframe}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query"
              ]
            },
            "description": "Fetches time-series valuation points and period returns based on the {{timeframe}} collection variable (e.g., TIMEFRAME_1D, TIMEFRAME_1W, TIMEFRAME_1M, TIMEFRAME_1Y, TIMEFRAME_ALL)."
          },
          "response": []
        },
