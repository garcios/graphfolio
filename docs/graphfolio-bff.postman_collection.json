{
  "info": {
    "_postman_id": "c035aaf4-e7ca-40d1-8687-00e1efc72f01",
    "name": "GraphFolio BFF GraphQL API",
    "description": "Postman Collection v2.1.0 for the GraphFolio Backend-For-Frontend (BFF) service.\n\nThe BFF orchestrates communication between the frontend React client and the underlying gRPC microservices (`portfolio-api`, `user-api`). It serves a GraphQL API on `http://localhost:8080/query` supporting portfolio summaries, instrument catalogs, historical valuation curves, paginated transaction ledger, and trade mutations.\n\nAll queries and mutations feature exact arbitrary-precision Decimal serialization and automated test assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Portfolio & Holdings",
      "description": "Portfolio aggregates, total value, cash balances, daily returns, and individual asset holdings.",
      "item": [
        {
          "name": "Get Portfolio Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"GraphQL response has no errors\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.errors).to.be.undefined;",
                  "    pm.expect(jsonData.data).to.be.an(\"object\");",
                  "});",
                  "",
                  "pm.test(\"Portfolio summary contains total value and investments\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.portfolio).to.exist;",
                  "    pm.expect(jsonData.data.portfolio.totalValue).to.exist;",
                  "    pm.expect(jsonData.data.portfolio.cashBalance).to.exist;",
                  "    pm.expect(jsonData.data.portfolio.investments).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetPortfolio {\n  portfolio {\n    totalValue {\n      amount\n      currencyCode\n    }\n    todayReturnAmount {\n      amount\n      currencyCode\n    }\n    todayReturnPercent\n    annualizedReturnPercent\n    cashBalance {\n      amount\n      currencyCode\n    }\n    investments {\n      id\n      ticker\n      name\n      price {\n        amount\n        currencyCode\n      }\n      quantity\n      totalValue {\n        amount\n        currencyCode\n      }\n      todayReturnAmount {\n        amount\n        currencyCode\n      }\n      todayReturnPercent\n      totalReturnAmount {\n        amount\n        currencyCode\n      }\n      totalReturnPercent\n    }\n  }\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query"
              ]
            },
            "description": "Fetches the full consolidated portfolio state including net worth, cash balance, annualized returns, today's performance, and all active asset holdings."
          },
          "response": []
        }
      ]
    },
