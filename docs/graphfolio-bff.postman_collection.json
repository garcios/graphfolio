    {
      "name": "5. Transaction Mutations",
      "description": "Mutations for recording trades, cash inflows/outflows, dividends, and deleting transactions with automatic projection replay.",
      "item": [
        {
          "name": "Add Transaction - BUY Stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"GraphQL response has no errors\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.errors).to.be.undefined;",
                  "    pm.expect(jsonData.data).to.be.an(\"object\");",
                  "});",
                  "",
                  "pm.test(\"BUY transaction recorded and returned valid transactionId\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const payload = jsonData.data.addTransaction;",
                  "    pm.expect(payload.transactionId).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"lastTransactionId\", payload.transactionId);",
                  "    console.log(\"Recorded lastTransactionId:\", payload.transactionId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
