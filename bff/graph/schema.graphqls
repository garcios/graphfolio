"Arbitrary-precision decimal serialized as a string, e.g. \"1234.56\"."
scalar Decimal

type Money {
  amount: Decimal!
  currencyCode: String!
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  DEPOSIT
  WITHDRAWAL
  INTEREST
  FEE
  TAX
  TRANSFER_IN
  TRANSFER_OUT
  FX_CONVERSION
  SPLIT
}

enum SortDirection {
  ASC
  DESC
}

input AddTransactionInput {
  type: TransactionType!
  symbol: String
  tradeDate: String! # YYYY-MM-DD
  quantity: Decimal
  price: Decimal
  amount: Decimal
  currencyCode: String
  fee: Decimal
  feeCurrencyCode: String
  notes: String
}

type AddTransactionPayload {
  transactionId: String!
  portfolio: Portfolio!
}

input UpdateTransactionInput {
  type: TransactionType!
  symbol: String
  tradeDate: String! # YYYY-MM-DD
  quantity: Decimal
  price: Decimal
  amount: Decimal!
  currencyCode: String
  fee: Decimal
  feeCurrencyCode: String
  notes: String
}

type UpdateTransactionPayload {
  success: Boolean!
  transaction: TransactionItem!
  portfolio: Portfolio!
}

type Instrument {
  id: ID!
  symbol: String!
  name: String!
  currencyCode: String!
  assetClass: String!
  exchangeCode: String!
  isin: String
  isActive: Boolean!
}

"Trading venue reference data identified by its ISO 10383 MIC code."
type Exchange {
  code: String!
  name: String!
  country: String!
  timezone: String!
}

type Query {
  portfolio(includeClosed: Boolean): Portfolio!
  instruments: [Instrument!]!
  portfolioHistory(timeframe: HistoryTimeframe!): PortfolioHistory!
  transactions(
    type: TransactionType
    symbol: String
    page: Int = 1
    pageSize: Int = 20
    sortDirection: SortDirection = DESC
  ): TransactionsConnection!

  exportTransactions(
    type: TransactionType
    symbol: String
  ): [TransactionItem!]!

  # Admin Queries
  allInstruments(isActive: Boolean, search: String): [Instrument!]!
  exchanges: [Exchange!]!
  instrumentPrices(
    symbol: String
    fromDate: String
    toDate: String
    limit: Int = 50
    offset: Int = 0
  ): InstrumentPricesConnection!
  ingestionStatus: IngestionStatus!

  # User Preferences Queries
  me: UserPreferences!
  userPreferences: UserPreferences!
  supportedCurrencies: [Currency!]!

  # FX & Currency Pair Queries
  currencyPairs: [CurrencyPair!]!
  currencyPairHistory(
    baseCurrency: String!
    quoteCurrency: String!
    timeframe: HistoryTimeframe!
  ): CurrencyPairHistory!
  fxRates(
    baseCurrency: String
    quoteCurrency: String
    fromDate: String
    toDate: String
    limit: Int = 50
    offset: Int = 0
  ): FXRatesConnection!

  # Multi-Broker CSV Ingestion Queries
  checkTransactionDuplicates(externalRefs: [String!]!): [String!]!

  # Portfolio Cash Flow Report Query
  cashFlowReport(filter: CashFlowFilterInput!): CashFlowReport!

  # Admin: Missing Prices Diagnostic Report
  missingPriceTransactions(
    symbol: String
    fromDate: String
    toDate: String
    limit: Int = 50
    offset: Int = 0
  ): MissingPriceReport!

  # Admin: Missing FX Rates Diagnostic Report
  missingFXRateTransactions(
    currencyPair: String
    fromDate: String
    toDate: String
    type: TransactionType
    limit: Int = 50
    offset: Int = 0
  ): MissingFXRatesReport!


  # Return Analytics: Modified Dietz Method
  modifiedDietzReturn(
    startDate: String!
    endDate: String!
    useMonthlyLinking: Boolean
  ): ModifiedDietzReturnPayload!

  # Benchmark Comparison & Relative Performance Queries
  benchmarks: [Benchmark!]!
  benchmarkComparison(
    benchmarkId: ID!
    timeframe: HistoryTimeframe!
    currencyMode: BenchmarkCurrencyMode = PORTFOLIO_BASE
  ): BenchmarkComparisonPayload!
}

enum HistoryTimeframe {
  TIMEFRAME_1D
  TIMEFRAME_1W
  TIMEFRAME_1M
  TIMEFRAME_1Y
  TIMEFRAME_ALL
}

type ValuationPoint {
  date: String!
  totalValue: Money!
  marketValue: Money!
  cashValue: Money!
  twrIndex: Decimal!
  dailyReturn: Decimal
}

type PortfolioHistory {
  points: [ValuationPoint!]!
  startValue: Money!
  endValue: Money!
  returnAmount: Money!
  returnPercent: Decimal!
}

type TransactionItem {
  id: ID!
  type: TransactionType!
  symbol: String
  instrumentName: String
  tradeDate: String!
  quantity: Decimal
  price: Money
  amount: Money!
  fee: Money!
  notes: String
  createdAt: String!
  withholdingTax: Money
  fxRateToBase: Decimal
  externalRef: String
}

type TransactionsConnection {
  items: [TransactionItem!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
}

type DeleteTransactionPayload {
  success: Boolean!
  portfolio: Portfolio!
}

type DeleteInstrumentPayload {
  success: Boolean!
  id: ID!
}

type Mutation {
  addTransaction(input: AddTransactionInput!): AddTransactionPayload!
  deleteTransaction(id: ID!): DeleteTransactionPayload!
  updateTransaction(id: ID!, input: UpdateTransactionInput!): UpdateTransactionPayload!

  # Admin Mutations
  createInstrument(input: CreateInstrumentInput!): Instrument!
  updateInstrument(input: UpdateInstrumentInput!): Instrument!
  deleteInstrument(id: ID!): DeleteInstrumentPayload!
  recordPriceOverride(input: RecordPriceOverrideInput!): RecordPriceOverridePayload!
  triggerMarketSync(symbols: [String!], syncFx: Boolean): MarketSyncPayload!
  triggerBackfill(input: TriggerBackfillInput!): BackfillPayload!

  # User Preferences Mutations
  updateUserPreferences(input: UpdateUserPreferencesInput!): UpdateUserPreferencesPayload!

  # FX & Currency Pair Mutations
  recordFXRateOverride(input: RecordFXRateOverrideInput!): RecordFXRateOverridePayload!

  # Multi-Broker CSV Ingestion Mutations
  importTransactions(input: BatchImportTransactionsInput!): BatchImportTransactionsPayload!

  # Identity & Authentication Mutations
  register(input: RegisterInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  refreshToken: AuthPayload!
  logout: Boolean!
  changePassword(input: ChangePasswordInput!): ChangePasswordPayload!
}

type AuthPayload {
  user: UserPreferences!
  accessToken: String!
  expiresIn: Int!
}

type ChangePasswordPayload {
  success: Boolean!
  message: String!
}

input ChangePasswordInput {
  currentPassword: String!
  newPassword: String!
  revokeOtherSessions: Boolean
}

input RegisterInput {
  email: String!
  password: String!
  displayName: String!
  displayCurrency: String!
}

input LoginInput {
  email: String!
  password: String!
  rememberMe: Boolean
}


input ImportTransactionInput {
  externalRef: String!
  symbol: String!
  type: TransactionType!
  tradeDate: String! # YYYY-MM-DD
  settleDate: String # YYYY-MM-DD
  quantity: Decimal!
  price: Decimal!
  amount: Decimal!
  fee: Decimal!
  feeCurrencyCode: String
  currencyCode: String # Default "AUD"
  notes: String
}

input BatchImportTransactionsInput {
  transactions: [ImportTransactionInput!]!
  skipDuplicates: Boolean = true
}

type BatchImportTransactionsPayload {
  success: Boolean!
  importedCount: Int!
  skippedCount: Int!
  portfolio: Portfolio!
  message: String!
}

type InstrumentPrice {
  id: ID!
  symbol: String!
  priceDate: String!
  price: Money!
  source: String!
  updatedAt: String!
}

type InstrumentPricesConnection {
  items: [InstrumentPrice!]!
  totalCount: Int!
}

input CreateInstrumentInput {
  symbol: String!
  exchangeCode: String!
  name: String!
  assetClass: String!
  currencyCode: String!
  isin: String
}

input UpdateInstrumentInput {
  id: ID!
  name: String
  isActive: Boolean
  isin: String
}

input RecordPriceOverrideInput {
  symbol: String!
  priceDate: String! # YYYY-MM-DD
  price: Decimal!
  reason: String
  recomputeValuations: Boolean
}

type RecordPriceOverridePayload {
  price: InstrumentPrice!
  valuationsRecomputed: Boolean!
}

type FeedHealthStatus {
  name: String!
  status: String!
  provider: String!
  schedule: String!
  lastRun: String!
  details: String!
}

type IngestionStatus {
  feeds: [FeedHealthStatus!]!
  trackedInstruments: Int!
  trackedCurrencies: Int!
  latestPriceDate: String
  latestFxDate: String
  rateLimitRemaining: Int!
  rateLimitBudget: Int!
  pendingBackfillJobs: Int!
}

type MarketSyncPayload {
  success: Boolean!
  pricesSynced: Int!
  fxRatesSynced: Int!
  message: String!
}

input TriggerBackfillInput {
  fromDate: String! # YYYY-MM-DD
  toDate: String!   # YYYY-MM-DD
  symbols: [String!]
  currencyPairs: [String!]
  backfillAssets: Boolean
  backfillFx: Boolean
  recomputeValuations: Boolean
}

type BackfillPayload {
  success: Boolean!
  pricesSynced: Int!
  fxRatesSynced: Int!
  message: String!
  warnings: [String!]!
}


type Portfolio {
  totalValue: Money!
  todayReturnAmount: Money!
  todayReturnPercent: Decimal!
  annualizedReturnPercent: Decimal!
  cashBalance: Money!
  investments: [Investment!]!
  inceptionDate: String
}

type Investment {
  id: ID!
  ticker: String!
  name: String!
  price: Money!
  averageBuyPrice: Money
  quantity: Decimal!
  totalValue: Money!
  todayReturnAmount: Money!
  todayReturnPercent: Decimal!
  totalReturnAmount: Money!
  totalReturnPercent: Decimal!

  # Multi-Currency Return Attribution
  capitalGainAmount: Money!
  capitalGainPercent: Decimal!
  incomeAmount: Money!
  incomeYieldPercent: Decimal!
  currencyGainAmount: Money!
  currencyGainPercent: Decimal!
  isInternational: Boolean!
  isClosed: Boolean!
}

type UserPreferences {
  userId: ID!
  email: String!
  displayName: String!
  displayCurrency: String!
  theme: String!
  createdAt: String!
  updatedAt: String!
}

type Currency {
  code: String!
  name: String!
  symbol: String!
}

input UpdateUserPreferencesInput {
  displayName: String
  displayCurrency: String
  theme: String
}

type UpdateUserPreferencesPayload {
  preferences: UserPreferences!
  portfolio: Portfolio
}

type CurrencyPair {
  baseCurrency: String!
  quoteCurrency: String!
  pair: String! # e.g. "EUR/USD"
  latestRate: Decimal!
  latestDate: String!
  latestSource: String!
  previousRate: Decimal
  change1dAmount: Decimal
  change1dPct: Decimal
  totalRecords: Int!
  firstDate: String!
  lastDate: String!
}

type FXRate {
  baseCurrency: String!
  quoteCurrency: String!
  pair: String!
  rateDate: String!
  rate: Decimal!
  invertedRate: Decimal!
  source: String!
}

type FXRatesConnection {
  items: [FXRate!]!
  totalCount: Int!
}

type FXHistoryPoint {
  date: String!
  rate: Decimal!
  invertedRate: Decimal!
  source: String!
}

type CurrencyPairHistory {
  baseCurrency: String!
  quoteCurrency: String!
  pair: String!
  points: [FXHistoryPoint!]!
  startRate: Decimal!
  endRate: Decimal!
  periodChange: Decimal!
  periodChangePct: Decimal!
  periodHigh: Decimal!
  periodLow: Decimal!
}

input RecordFXRateOverrideInput {
  baseCurrency: String!
  quoteCurrency: String!
  rateDate: String! # YYYY-MM-DD
  rate: Decimal!
  reason: String
  recomputeValuations: Boolean
}

type RecordFXRateOverridePayload {
  rate: FXRate!
  valuationsRecomputed: Boolean!
}

enum CashFlowTimeframe {
  MTD
  YTD
  M1
  M3
  M6
  Y1
  ALL
  CUSTOM
}

enum CashFlowDirection {
  INFLOW
  OUTFLOW
}

enum CashFlowCategory {
  CAPITAL_DEPOSITS
  DIVIDENDS
  INTEREST
  SALE_PROCEEDS
  CAPITAL_WITHDRAWALS
  PURCHASES
  FEES
  TAXES
}

input CashFlowFilterInput {
  timeframe: CashFlowTimeframe!
  fromDate: String       # YYYY-MM-DD
  toDate: String         # YYYY-MM-DD
  currency: String       # Optional target currency
}

type CashFlowSummary {
  startingCashBalance: Money!
  totalInflows: Money!
  totalOutflows: Money!
  netCashFlow: Money!
  endingCashBalance: Money!
}

type CashFlowCategoryBreakdown {
  deposits: Money!
  dividends: Money!
  interest: Money!
  salesProceeds: Money!
  withdrawals: Money!
  purchases: Money!
  fees: Money!
  taxes: Money!
}

type CashFlowItem {
  id: ID!
  eventDate: String!
  type: TransactionType!
  flowDirection: CashFlowDirection!
  category: CashFlowCategory!
  symbol: String
  instrumentName: String
  description: String!
  netAmount: Money!
  runningBalance: Money!
  localAmount: Money!
  fee: Money!
  withholdingTax: Money!
}

type CashFlowReport {
  summary: CashFlowSummary!
  breakdown: CashFlowCategoryBreakdown!
  items: [CashFlowItem!]!
  baseCurrency: String!
  fromDate: String!
  toDate: String!
}

# ------------------------------------------------------------------
# Admin: Missing Prices Diagnostic Report Types
# ------------------------------------------------------------------

type MissingPriceTransactionItem {
  transactionId: ID!
  portfolioId: ID!
  instrumentId: ID!
  symbol: String!
  assetName: String!
  exchangeMic: String!
  tradeDate: String!
  type: TransactionType!
  quantity: Decimal!
  executionPrice: Money!
  currencyCode: String!
}

type MissingPriceReport {
  items: [MissingPriceTransactionItem!]!
  totalCount: Int!
  uniqueInstrumentsCount: Int!
  earliestTradeDate: String
  latestTradeDate: String
}

# ------------------------------------------------------------------
# Admin: Missing FX Rates Diagnostic Report Types
# ------------------------------------------------------------------

type MissingFXRateTransactionItem {
  transactionId: ID!
  portfolioId: ID!
  portfolioName: String!
  portfolioBaseCurrency: String!
  tradeDate: String!
  type: TransactionType!
  instrumentId: ID
  symbol: String
  assetName: String
  amount: Money!
  transactionCurrency: String!
  requiredPair: String!
  recordedFxRate: Decimal
}

type MissingFXRatesReport {
  items: [MissingFXRateTransactionItem!]!
  totalCount: Int!
  uniquePairsCount: Int!
  earliestTradeDate: String
  latestTradeDate: String
}


# ------------------------------------------------------------------
# Return Analytics: Modified Dietz Method Types
# ------------------------------------------------------------------

type ModifiedDietzReturnPayload {
  portfolioId: ID!
  baseCurrency: String!
  startDate: String!
  endDate: String!
  elapsedDays: Int!
  startValuation: Money!
  endValuation: Money!
  netExternalFlows: Money!
  netInvestmentGain: Money!
  weightedCapitalEmployed: Money!
  cumulativeReturnPercent: Decimal!
  annualizedReturnPercent: Decimal
  isAnnualized: Boolean!
  isComputable: Boolean!
  diagnosticCode: String!
  cashFlowWeights: [ExternalCashFlowWeightItem!]!
}

type ExternalCashFlowWeightItem {
  transactionId: ID!
  date: String!
  type: TransactionType!
  amount: Money!
  weight: Decimal!
  weightedAmount: Money!
  localAmount: Money!
}

# ------------------------------------------------------------------
# Benchmark Comparison & Relative Performance Types
# ------------------------------------------------------------------

enum BenchmarkCurrencyMode {
  PORTFOLIO_BASE
  BENCHMARK_NATIVE
}

type Benchmark {
  id: ID!
  symbol: String!
  name: String!
  exchangeCode: String!
  currencyCode: String!
  indexType: String!
  isDefault: Boolean!
}

type BenchmarkComparisonPoint {
  date: String!
  portfolioReturnPercent: Decimal!
  benchmarkReturnPercent: Decimal!
  activeReturnPercent: Decimal!
  portfolioValue: Money!
  benchmarkPriceAdjusted: Money!
}

type BenchmarkMetrics {
  portfolioCumulativeReturnPercent: Decimal!
  benchmarkCumulativeReturnPercent: Decimal!
  activeCumulativeReturnPercent: Decimal!
  portfolioAnnualizedReturnPercent: Decimal
  benchmarkAnnualizedReturnPercent: Decimal
  activeAnnualizedReturnPercent: Decimal
  isAnnualized: Boolean!
  beta: Decimal
  trackingErrorPercent: Decimal
  informationRatio: Decimal
}

type BenchmarkComparisonPayload {
  portfolioId: ID!
  baseCurrency: String!
  benchmark: Benchmark!
  currencyMode: BenchmarkCurrencyMode!
  startDate: String!
  endDate: String!
  elapsedDays: Int!
  points: [BenchmarkComparisonPoint!]!
  metrics: BenchmarkMetrics!
}


